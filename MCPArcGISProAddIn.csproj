<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>CA1416</NoWarn>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core isn't part of the base .NET runtime; needed to host Kestrel/MCP. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Pinned to 0.4.0-preview.3, NOT the newer stable 2.2.0/1.x/0.5+ releases: starting at
      0.4.1-preview.1, this SDK's net8.0 build switched to being compiled against
      Microsoft.Extensions.*/System.* v10.0.0.0: a hard AssemblyRef baked into the DLL's
      own metadata (CS1705), not just a loose version range, so no amount of pinning those
      transitive packages down can fix it. 0.4.0-preview.3 is the last version whose net8.0
      build genuinely targets net8.0-era (8.0.1) dependencies, which is what actually
      matters here since we're loaded as a plugin inside ArcGIS Pro's own net8.0 process
      (see McpHostService's AssemblyLoadContext.Resolving hook for the fuller story).
    -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.4.0-preview.3" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Config.daml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Config.daml" />    
    <Content Include="Images\AddInDesktop16.png" />
    <Content Include="Images\AddInDesktop32.png" />
    <Content Include="DarkImages\AddInDesktop16.png" />
    <Content Include="DarkImages\AddInDesktop32.png" />    
  </ItemGroup>
  <ItemGroup>
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>
  <ItemGroup>
